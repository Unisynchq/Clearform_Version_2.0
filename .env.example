# Copy to `.env.local` for local development

# When set, API facades in src/api/services/* call the backend instead of localStorage stubs.
# Leave unset for frontend-only local work (see FRONTEND_DEV.md).
VITE_API_BASE_URL=https://api.example.com/v1

# Composio OAuth (CLE-19): after connecting in Profile -> Integrations, the API redirects to
# /dashboard/profile?tab=integrations&connected=<provider> - ensure that URL is allowed in
# the Composio dashboard for your app (e.g. https://app.clearform.in).

# Set to false to require VITE_API_BASE_URL (no localStorage fallback in services).
VITE_USE_MOCK_API=true

# Supabase auth
# Used for email/password session restore plus Google/Microsoft OAuth.
# Add your app URL and /signin callback URL to the Supabase redirect allow-list.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_MICROSOFT_PROVIDER=azure

# Sentry — browser errors + tracing (optional locally; set in production deploy)
# Production: VITE_SENTRY_DSN, VITE_SENTRY_ENVIRONMENT=production,
# VITE_SENTRY_RELEASE or VITE_VERCEL_GIT_COMMIT_SHA for release tagging.
# Set VITE_VERCEL_ENV = VERCEL_ENV in every Vercel environment (Vite only
# exposes VITE_ vars). Non-production values override VITE_SENTRY_ENVIRONMENT
# so preview builds stay out of the production issue stream.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_RELEASE=
VITE_VERCEL_ENV=

# PostHog - product analytics (signup, sign-in, usage). Project: Clearform (US cloud).
# Token: PostHog -> Project settings -> Project API key. Do not commit real tokens.
VITE_POSTHOG_PROJECT_TOKEN=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Razorpay - enables checkout flow when set to true
VITE_ENABLE_RAZORPAY_CHECKOUT=
