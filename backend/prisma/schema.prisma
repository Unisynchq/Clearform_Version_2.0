generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String           @id @default(uuid())
  email                 String           @unique
  username              String?          @unique
  firstName             String
  lastName              String
  timezone              String           @default("UTC")
  passwordHash          String           @default("")
  createdAt             DateTime         @default(now())
  deletedAt             DateTime?        @map("deleted_at")
  onboardingCompletedAt DateTime?
  avatarUrl             String?
  passwordLastChangedAt DateTime?
  emailLogs             EmailLog[]
  forms                 Form[]
  notifications         Notification[]
  pilotPurchase         PilotPurchase?
  promoRedemption       PromoRedemption?
  subscription          Subscription?
  workspaces            Workspace[]
  aiCreditLedger        AiCreditLedger[]
  aiUsage               AiUsage?
}

model AiUsage {
  id                   String   @id @default(uuid())
  userId               String   @unique
  logicGenerationsUsed Int      @default(0)
  qualitySessionsUsed  Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @default(now()) @updatedAt
  aiCreditsUsed        Int      @default(0)
  aiCreditsPeriodStart DateTime @default(now())
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ai_usage")
}

model AiCreditLedger {
  id        String   @id @default(uuid())
  userId    String
  action    String
  credits   Int
  formId    String?
  status    String
  meta      Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([formId, createdAt(sort: Desc)])
  @@map("ai_credit_ledger")
}

model EmailLog {
  id            String    @id @default(uuid())
  userId        String?
  toEmail       String
  template      String
  subject       String
  resendEmailId String?   @unique
  status        String    @default("queued")
  metadata      Json?
  lastEventAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User?     @relation(fields: [userId], references: [id])

  @@index([userId, template])
  @@index([resendEmailId])
  @@index([status, createdAt(sort: Desc)])
}

model Subscription {
  id                String             @id @default(uuid())
  userId            String             @unique
  planId            String
  razorpaySubId     String?
  status            SubscriptionStatus @default(TRIAL)
  responsesUsed     Int                @default(0)
  responsesLimit    Int                @default(50)
  periodStart       DateTime           @default(now())
  periodEnd         DateTime
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @default(now()) @updatedAt
  razorpayPaymentId String?            @unique
  source            SubscriptionSource @default(RAZORPAY)
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PromoCode {
  id              String            @id @default(uuid())
  code            String            @unique
  active          Boolean           @default(true)
  note            String?
  redemptionCount Int               @default(0)
  createdAt       DateTime          @default(now())
  durationDays    Int?
  redemptions     PromoRedemption[]
}

model PromoRedemption {
  id               String    @id @default(uuid())
  promoCodeId      String
  userId           String    @unique
  redeemedAt       DateTime  @default(now())
  grantedExpiresAt DateTime
  promoCode        PromoCode @relation(fields: [promoCodeId], references: [id])
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PilotPurchase {
  id                    String    @id @default(uuid())
  razorpayPaymentId     String    @unique
  razorpayOrderId       String?
  razorpayPaymentLinkId String?
  email                 String?
  amountPaise           Int
  currency              String
  status                String
  planId                String
  purchasedAt           DateTime
  expiresAt             DateTime
  userId                String?   @unique
  claimedAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @default(now()) @updatedAt
  user                  User?     @relation(fields: [userId], references: [id])
}

model Workspace {
  id                     String                  @id @default(uuid())
  label                  String
  colour                 String?
  ownerId                String
  createdAt              DateTime                @default(now())
  forms                  Form[]
  integrationConnections IntegrationConnection[]
  owner                  User                    @relation(fields: [ownerId], references: [id])
}

model Form {
  id                     String         @id @default(uuid())
  title                  String
  status                 FormStatus     @default(DRAFT)
  isPaused               Boolean        @default(false) @map("is_paused")
  pausedAt               DateTime?      @map("paused_at")
  deletedAt              DateTime?      @map("deleted_at")
  permanentDeleteAt      DateTime?      @map("permanent_delete_at")
  workspaceId            String?
  ownerId                String
  gradientFrom           String         @default("#6366f1")
  gradientTo             String         @default("#8b5cf6")
  overlayColor           String         @default("rgba(99,102,241,0.15)")
  iconGradient           String         @default("linear-gradient(135deg,#6366f1,#8b5cf6)")
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  builderSnapshot        Json?
  publishedAt            DateTime?
  publishedSnapshot      Json?
  builderSnapshotVersion Int            @default(0)
  aiFeedback             AiFeedback[]
  owner                  User           @relation(fields: [ownerId], references: [id])
  workspace              Workspace?     @relation(fields: [workspaceId], references: [id])
  responses              FormResponse[]
  settings               FormSettings?
  webhooks               Webhook[]
}

model FormSettings {
  id                   String    @id @default(uuid())
  formId               String    @unique
  responseLimit        Int?
  pauseUntil           DateTime?
  notificationsEnabled Boolean   @default(true)
  passwordHash         String?
  passwordHint         String?
  autoCloseAt          DateTime?
  shareEnabled         Boolean   @default(true)
  form                 Form      @relation(fields: [formId], references: [id], onDelete: Cascade)
}

model Webhook {
  id              String            @id @default(uuid())
  formId          String
  url             String
  triggers        Json              @default("[]")
  active          Boolean           @default(true)
  createdAt       DateTime          @default(now())
  secret          String?
  lastDeliveredAt DateTime?
  lastError       String?
  form            Form              @relation(fields: [formId], references: [id], onDelete: Cascade)
  deliveries      WebhookDelivery[]
}

model WebhookDelivery {
  id         String   @id @default(uuid())
  webhookId  String
  event      String
  statusCode Int?
  success    Boolean  @default(false)
  error      String?
  attempt    Int      @default(1)
  createdAt  DateTime @default(now())
  webhook    Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, createdAt(sort: Desc)])
}

model FormResponse {
  id             String         @id @default(uuid())
  formId         String
  payload        Json
  status         ResponseStatus @default(PENDING)
  qualityScore   Int?
  completedAt    DateTime?
  durationMs     Int?
  createdAt      DateTime       @default(now())
  dropOffFieldId String?
  aiFeedback     AiFeedback[]
  form           Form           @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId, createdAt])
  @@index([formId, status])
  @@index([formId, qualityScore(sort: Desc)])
}

model AiFeedback {
  id           String       @id @default(uuid())
  formId       String
  responseId   String
  screenId     String?
  rating       Int
  note         String?
  aiDecision   String
  actualAnswer String?
  createdBy    String
  createdAt    DateTime     @default(now())
  form         Form         @relation(fields: [formId], references: [id], onDelete: Cascade)
  response     FormResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)

  @@index([formId, createdAt])
  @@index([responseId])
  @@index([rating, createdAt(sort: Desc)])
  @@index([formId, rating, createdAt])
}

model Notification {
  id         String    @id @default(uuid())
  userId     String
  formId     String?
  responseId String?
  type       String
  title      String
  body       String
  readAt     DateTime?
  createdAt  DateTime  @default(now())
  action     Json?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, readAt])
  @@index([userId, type])
}

model FormMemoryChunk {
  id        String                 @id @default(uuid())
  formId    String
  chunkType String
  content   String
  embedding Unsupported("vector")?
  metadata  Json?
  createdAt DateTime               @default(now())

  @@index([formId])
  @@map("form_memory_chunks")
}

model AiCallLog {
  id           String   @id @default(uuid())
  formId       String?
  task         String
  tier         String
  provider     String
  model        String
  latencyMs    Int
  promptTokens Int?
  outputTokens Int?
  success      Boolean  @default(true)
  errorSnippet String?
  createdAt    DateTime @default(now())
  ownerUserId  String?
  costUsd      Float?

  @@index([createdAt(sort: Desc)])
  @@index([provider, task, createdAt(sort: Desc)])
  @@index([ownerUserId, createdAt(sort: Desc)])
  @@map("ai_call_logs")
}

model IntegrationConnection {
  id               String    @id @default(uuid())
  workspaceId      String
  provider         String
  composioEntityId String?
  metadata         Json?
  active           Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

enum SubscriptionSource {
  RAZORPAY
  PROMO
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  TRIAL
}

enum FormStatus {
  LIVE
  DRAFT
  ARCHIVED
  TRASH
}

enum ResponseStatus {
  PENDING
  PROCESSED
  FAILED
  ABANDONED
}
