generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String         @id @default(uuid())
  email                 String         @unique
  firstName             String
  lastName              String
  avatarUrl             String?
  passwordHash          String         @default("")
  onboardingCompletedAt DateTime?
  createdAt             DateTime       @default(now())
  workspaces            Workspace[]
  forms                 Form[]
  subscription          Subscription?
  pilotPurchase         PilotPurchase?
  notifications         Notification[]
  emailLogs             EmailLog[]
  aiUsage               AiUsage?
  aiCreditLedger        AiCreditLedger[]
  promoRedemption       PromoRedemption?
}

/// Lifetime AI trial counters per account (free tier). Prisma is the source
/// of truth — these must survive Redis flushes; Redis only dedups increments.
model AiUsage {
  id                   String   @id @default(uuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  logicGenerationsUsed Int      @default(0)
  qualitySessionsUsed  Int      @default(0)
  /** Cumulative AI credits charged in the current credit period (product actions). */
  aiCreditsUsed        Int      @default(0)
  /** Free tier: calendar-month anchor. Pilot: reset when pilot activates. */
  aiCreditsPeriodStart DateTime @default(now())
  createdAt            DateTime @default(now())
  updatedAt            DateTime @default(now()) @updatedAt

  @@map("ai_usage")
}

/** Append-only ledger of AI credit asserts/debits for transparency. */
model AiCreditLedger {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  credits   Int
  formId    String?
  status    String
  meta      Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([formId, createdAt(sort: Desc)])
  @@map("ai_credit_ledger")
}

model EmailLog {
  id            String    @id @default(uuid())
  userId        String?
  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  toEmail       String
  template      String
  subject       String
  resendEmailId String?   @unique
  status        String    @default("queued")
  metadata      Json?
  lastEventAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId, template])
  @@index([resendEmailId])
  @@index([status, createdAt(sort: Desc)])
}

model Subscription {
  id                  String             @id @default(uuid())
  userId              String             @unique
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId              String
  razorpaySubId       String?
  razorpayPaymentId   String?            @unique
  status              SubscriptionStatus @default(TRIAL)
  responsesUsed       Int                @default(0)
  responsesLimit      Int                @default(50)
  periodStart         DateTime           @default(now())
  periodEnd           DateTime
  source              SubscriptionSource @default(RAZORPAY)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @default(now()) @updatedAt
}

enum SubscriptionSource {
  RAZORPAY
  PROMO
}

/// Single shared invite-only promo code (not per-user) — redeeming grants a
/// pilot trial of `durationDays` days (fallback: PROMO_TRIAL_DAYS). Uniqueness
/// is enforced on PromoRedemption.userId, not on the code itself, since many
/// invited people share the same code string.
model PromoCode {
  id              String   @id @default(uuid())
  code            String   @unique
  active          Boolean  @default(true)
  note            String?
  durationDays    Int?
  redemptionCount Int      @default(0)
  createdAt       DateTime @default(now())

  redemptions PromoRedemption[]
}

model PromoRedemption {
  id               String    @id @default(uuid())
  promoCodeId      String
  promoCode        PromoCode @relation(fields: [promoCodeId], references: [id])
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  redeemedAt       DateTime  @default(now())
  grantedExpiresAt DateTime
}

model PilotPurchase {
  id                    String   @id @default(uuid())
  razorpayPaymentId     String   @unique
  razorpayOrderId       String?
  razorpayPaymentLinkId String?
  email                 String?
  amountPaise           Int
  currency              String
  status                String
  planId                String
  purchasedAt           DateTime
  expiresAt             DateTime
  userId                String?  @unique
  user                  User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  claimedAt             DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @default(now()) @updatedAt
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
}

model Workspace {
  id                     String                  @id @default(uuid())
  label                  String
  colour                 String?
  ownerId                String
  owner                  User                    @relation(fields: [ownerId], references: [id])
  forms                  Form[]
  integrationConnections IntegrationConnection[]
  createdAt              DateTime                @default(now())
}

model Form {
  id                String         @id @default(uuid())
  title             String
  status            FormStatus     @default(DRAFT)
  workspaceId       String?
  workspace         Workspace?     @relation(fields: [workspaceId], references: [id])
  ownerId           String
  owner             User           @relation(fields: [ownerId], references: [id])
  gradientFrom      String         @default("#6366f1")
  gradientTo        String         @default("#8b5cf6")
  overlayColor      String         @default("rgba(99,102,241,0.15)")
  iconGradient      String         @default("linear-gradient(135deg,#6366f1,#8b5cf6)")
  builderSnapshot   Json?
  builderSnapshotVersion Int @default(0)
  publishedSnapshot Json?
  publishedAt       DateTime?
  settings          FormSettings?
  webhooks          Webhook[]
  responses         FormResponse[]
  aiFeedback        AiFeedback[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

enum FormStatus {
  LIVE
  DRAFT
  ARCHIVED
  TRASH
}

model FormSettings {
  id                   String    @id @default(uuid())
  formId               String    @unique
  form                 Form      @relation(fields: [formId], references: [id], onDelete: Cascade)
  responseLimit        Int?
  pauseUntil           DateTime?
  notificationsEnabled Boolean   @default(true)
  passwordHash         String?
  passwordHint         String?
  autoCloseAt          DateTime?
  shareEnabled         Boolean   @default(true)
}

model Webhook {
  id              String            @id @default(uuid())
  formId          String
  form            Form              @relation(fields: [formId], references: [id], onDelete: Cascade)
  url             String
  triggers        Json              @default("[]")
  secret          String?
  active          Boolean           @default(true)
  lastDeliveredAt DateTime?
  lastError       String?
  createdAt       DateTime          @default(now())
  deliveries      WebhookDelivery[]
}

model WebhookDelivery {
  id         String   @id @default(uuid())
  webhookId  String
  webhook    Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event      String
  statusCode Int?
  success    Boolean  @default(false)
  error      String?
  attempt    Int      @default(1)
  createdAt  DateTime @default(now())

  @@index([webhookId, createdAt(sort: Desc)])
}

model FormResponse {
  id             String         @id @default(uuid())
  formId         String
  form           Form           @relation(fields: [formId], references: [id], onDelete: Cascade)
  payload        Json
  status         ResponseStatus @default(PENDING)
  qualityScore   Int?
  completedAt    DateTime?
  durationMs     Int?
  dropOffFieldId String?
  createdAt      DateTime       @default(now())
  aiFeedback     AiFeedback[]

  @@index([formId, createdAt])
  @@index([formId, status])
  @@index([formId, qualityScore(sort: Desc)])
}

model AiFeedback {
  id           String      @id @default(uuid())
  formId       String
  form         Form        @relation(fields: [formId], references: [id], onDelete: Cascade)
  responseId   String
  response     FormResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  screenId     String?
  rating       Int
  note         String?
  aiDecision   String
  actualAnswer String?
  createdBy    String
  createdAt    DateTime    @default(now())

  @@index([formId, createdAt])
  @@index([responseId])
  @@index([rating, createdAt(sort: Desc)])
  @@index([formId, rating, createdAt])
}

enum ResponseStatus {
  PENDING
  PROCESSED
  FAILED
  ABANDONED
}

model Notification {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  formId     String?
  responseId String?
  type       String
  title      String
  body       String
  readAt     DateTime?
  createdAt  DateTime  @default(now())
}

model FormMemoryChunk {
  id        String                       @id @default(uuid())
  formId    String
  chunkType String
  content   String
  embedding Unsupported("vector(1536)")?
  metadata  Json?
  createdAt DateTime                     @default(now())

  @@index([formId])
  @@map("form_memory_chunks")
}

/// One row per resolved LLM attempt — observability for the Gemini rollout
/// (provider/model/latency/tokens). Written fire-and-forget by LlmGatewayService.
model AiCallLog {
  id           String   @id @default(uuid())
  formId       String?
  ownerUserId  String?
  task         String
  tier         String
  provider     String
  model        String
  latencyMs    Int
  promptTokens Int?
  outputTokens Int?
  costUsd      Float?
  success      Boolean  @default(true)
  errorSnippet String?
  createdAt    DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([provider, task, createdAt(sort: Desc)])
  @@index([ownerUserId, createdAt(sort: Desc)])
  @@map("ai_call_logs")
}

model IntegrationConnection {
  id               String    @id @default(uuid())
  workspaceId      String
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  provider         String
  composioEntityId String?
  metadata         Json?
  active           Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}
