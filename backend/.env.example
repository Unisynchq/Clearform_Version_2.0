# Runtime mode — PM2 sets NODE_ENV=production on VPS; local dev leaves unset
# NODE_ENV=production

# Supabase PostgreSQL
# Prisma needs both: pooled connection for runtime, direct connection for migrations
DATABASE_URL="postgresql://postgres.[PROJECT]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Redis — Upstash Pro recommended for production (BullMQ + cache + LiteLLM semantic cache)
# Free tier: 500k commands/month — Bull queues will exhaust quota under load
REDIS_URL="rediss://default:[PASSWORD]@[UPSTASH_HOST]:6379"
# Optional — parsed for LiteLLM semantic cache (see docker/litellm/litellm.config.yaml)
# REDIS_HOST=
# REDIS_PORT=6379
# REDIS_PASSWORD=

# AI insights — use Bull queue when Redis Pro is enabled (recommended production)
AI_INSIGHTS_USE_QUEUE=true

# Firebase Admin SDK (use ONE of the two options below)
# Option A — path to downloaded service account JSON (recommended for local dev)
FIREBASE_CREDENTIALS_PATH="./clearform-284ce-firebase-adminsdk-fbsvc-4cf8039acf.json"
# Option B — inline JSON single-line string (common in production env vars)
# FIREBASE_CREDENTIALS_JSON='{"type":"service_account","project_id":"..."}'
# Profile avatars — must match VITE_FIREBASE_STORAGE_BUCKET on the frontend
# FIREBASE_STORAGE_BUCKET=clearform-284ce.appspot.com

# CORS — comma-separated list of allowed frontend origins (no trailing slash)
CORS_ORIGIN=http://localhost:5174,http://localhost:5173
# Production:
# CORS_ORIGIN=https://app.clearform.in

# Legacy JWT (register/login endpoints only — still required in production startup)
JWT_SECRET=
JWT_REFRESH_SECRET=

# AI — Gemini Developer API. Sole provider for pro/pilot/promo-trial (billed
# to the upgraded Firebase pay-as-you-go project). Create key: Firebase
# console → AI Logic or aistudio.google.com/apikey with the Clearform project.
GEMINI_API_KEY=
# Model overrides — one best-fit model per AI service (defaults shown).
# GEMINI_MODEL_PRO=gemini-2.5-flash        # fast: live quality nudges, improve-instructions, Cleo, intent
# GEMINI_MODEL_FREE=gemini-2.5-flash-lite  # unused unless free tier is later moved onto Gemini
# GEMINI_MODEL_LOGIC_PRO=gemini-2.5-pro       # logic: form-builder generation (runs once per session)
# GEMINI_MODEL_INSIGHTS_PRO=gemini-2.5-pro    # insights: dashboard aggregate analysis

# AI — OpenRouter (one key, many free models). Sole provider for free tier —
# pro tier never reaches OpenRouter; it goes straight to Gemini above.
OPENROUTER_API_KEY=

# Legacy — optional; superseded by LiteLLM + OpenRouter when set above
NVIDIA_NIM_API_KEY=

# Razorpay — pilot Payment Link ($34.99 one-time) + optional subscription upgrades
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_ID_PILOT_35=
RAZORPAY_PAYMENT_LINK_ID_PILOT=plink_Svut5N9dVQgBDU

# Pilot duration after Payment Link capture (days)
PILOT_DURATION_DAYS=90

# Comma-separated emails allowed to hit GET /api/v1/billing/platform-stats.
# Empty = deny everyone (fail closed).
PLATFORM_STATS_EMAILS=

# Pilot payment link flow — set false in production (webhook + claim-purchase only)
BILLING_ALLOW_PAYMENT_LINK_CONFIRM=true

PORT=3000

# Resend — transactional email notifications (https://resend.com)
RESEND_API_KEY=
RESEND_FROM=Clearform <hello@app.clearform.in>
RESEND_REPLY_TO=hello@app.clearform.in
# Webhook signing secret from Resend dashboard (starts with whsec_)
RESEND_WEBHOOK_SECRET=
# Optional — Resend dashboard template IDs (publish templates first). Leave blank to use inline HTML.
# RESEND_TEMPLATE_WELCOME=
# RESEND_TEMPLATE_TIER_UPGRADE=
# RESEND_TEMPLATE_RESPONSE_CREATED=

# Frontend URL — used in email links
APP_URL=https://app.clearform.in

# Public respondent form origin — canonical share/respond URL base (no trailing slash)
# Required in production (NODE_ENV=production). Local: http://localhost:5173
PUBLIC_FORM_ORIGIN=http://localhost:5173

# Frontend URL for email links and Composio OAuth redirect — required in production
APP_URL=https://app.clearform.in

# Composio — third-party integrations (CLE-19)
# Checklist:
#   1. Composio dashboard: enable googlesheets, slack, googledrive apps
#   2. COMPOSIO_API_KEY from Composio project settings
#   3. OAuth redirect URL (must match Composio dashboard):
#        COMPOSIO_OAUTH_CALLBACK_URL=https://api.clearform.in/api/v1/integrations/callback
#      Or set API_PUBLIC_URL=https://api.clearform.in (callback path is appended)
#   4. APP_URL=https://app.clearform.in (post-connect redirect to profile integrations tab)
#   5. After connect, PATCH connection metadata:
#        google_sheets → { "spreadsheetId": "...", "sheetRange": "Sheet1!A1" }
#        slack → { "slackChannel": "#general" }
#        google_drive → optional folder metadata per product spec
# Supported provider slugs: google_sheets, slack, google_drive, notion
COMPOSIO_API_KEY=
# Optional — override auth config ids from Composio dashboard (ac_...)
# COMPOSIO_AUTH_CONFIG_GOOGLE_SHEETS=
# COMPOSIO_AUTH_CONFIG_SLACK=
# COMPOSIO_AUTH_CONFIG_GOOGLE_DRIVE=
# COMPOSIO_AUTH_CONFIG_NOTION=
# Optional — defaults to https://api.clearform.in/api/v1/integrations/callback
# COMPOSIO_OAUTH_CALLBACK_URL=https://api.clearform.in/api/v1/integrations/callback
# API_PUBLIC_URL=https://api.clearform.in

# Cloudflare — optional cache purge on republish (zone for api.clearform.in)
# CLOUDFLARE_ZONE_ID=
# CLOUDFLARE_API_TOKEN=
# Integration OAuth adapter: composio (default) | nango (future)
INTEGRATION_PROVIDER=composio

# Sentry — error, performance, and log monitoring (optional locally; recommended in production)
# https://docs.sentry.io/platforms/javascript/guides/nestjs/
# Sentry project: clearform-api — https://clearform.sentry.io
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
# Optional; default clearform-api@<git-sha> in instrument.ts
# SENTRY_RELEASE=clearform-api@abc1234
# Optional: GET /api/v1/health/sentry-verify with header x-sentry-verify-key
# SENTRY_VERIFY_KEY=

# Linear — optional API key for future automation (Sentry→Linear is configured in dashboards)
LINEAR_API_KEY=

# Response quality v2 — intent-first signals (default on; set false to disable)
# QUALITY_INTENT_V2=true
