# =============================================================================
# Clearform Backend — Environment Configuration Template
# =============================================================================
# Copy to .env and fill in your values. Never commit .env or real secrets.
# =============================================================================

# Runtime mode — PM2 sets NODE_ENV=production on VPS; local dev leaves unset
# NODE_ENV=production

# Database
DATABASE_URL="postgresql://user:password@host:6543/db?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/db"

# Redis
REDIS_URL="rediss://default:password@host:6379"

# AI insights — use Bull queue when Redis Pro is enabled (recommended production)
AI_INSIGHTS_USE_QUEUE=true

# Firebase Admin SDK
# FIREBASE_CREDENTIALS_PATH="./service-account.json"
# FIREBASE_CREDENTIALS_JSON='{"type":"service_account",...}'
# FIREBASE_STORAGE_BUCKET=project-id.appspot.com

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5174,http://localhost:5173
# CORS_ORIGIN=https://app.clearform.in

# JWT secrets — generate with: openssl rand -base64 32
JWT_SECRET=
JWT_REFRESH_SECRET=

# Supabase JWT secret (for Firebase Auth token verification)
SUPABASE_JWT_SECRET=

# AI — Gemini API Key
GEMINI_API_KEY=

# AI — OpenRouter API Key
OPENROUTER_API_KEY=

# Razorpay — pilot Payment Link
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_ID_PILOT_35=
RAZORPAY_PAYMENT_LINK_ID_PILOT=

# Pilot duration after Payment Link capture (days)
PILOT_DURATION_DAYS=90

# Platform stats access (comma-separated emails)
PLATFORM_STATS_EMAILS=

# Allow payment link confirmation in dev only
BILLING_ALLOW_PAYMENT_LINK_CONFIRM=true

PORT=3000

# Resend — transactional email
RESEND_API_KEY=
RESEND_FROM=Clearform <hello@app.clearform.in>
RESEND_REPLY_TO=hello@app.clearform.in
RESEND_WEBHOOK_SECRET=

# Frontend URL
APP_URL=http://localhost:5173

# Public form origin
PUBLIC_FORM_ORIGIN=http://localhost:5173

# Composio — third-party integrations
COMPOSIO_API_KEY=
INTEGRATION_PROVIDER=composio

# Cloudflare — optional cache purge on republish
# CLOUDFLARE_ZONE_ID=
# CLOUDFLARE_API_TOKEN=

# Sentry — error monitoring
# SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# AWS Secrets Manager (optional, for production secret management)
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SECRET_NAME=clearform/production
